		"@react-native/jest-preset": "^0.86.3",
		"@react-native/typescript-config": "^0.74.0",
		"@types/css-to-react-native": "3.0.2",
		"@types/html-escaper": "3.0.2",
		"@types/jest": "29.5.14",
		"@types/node": "20.12.7",
