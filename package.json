{
	"name": "udev",
	"version": "1.0.0-beta.4",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"android": "expo run:android",
		"ios": "expo run:ios",
		"lint": "biome check ./",
		"lint:apply": "biome check ./ --apply-unsafe",
		"format": "biome format ./",
		"format:apply": "biome format ./ --write",
		"start": "expo start --dev-client",
		"prebuild": "expo prebuild --clean",
		"prebuild:android": "expo prebuild --clean --platform android",
		"test": "jest",
		"android:release": "npm run prebuild:android && npm run android:clean && npm run android:bundle && npm run android:assemble",
		"android:clean": "cd android && ./gradlew clean && ./gradlew --stop && cd ..",
		"android:bundle": "cd android && ./gradlew bundleRelease && ./gradlew --stop && cd ..",
		"android:assemble": "cd android && ./gradlew assembleRelease && ./gradlew --stop && cd ..",
		"check:tsc": "tsc --noEmit",
		"postinstall": "husky install && patch-package"
	},
	"dependencies": {
		"@react-native-community/netinfo": "12.0.1",
		"@react-native-community/slider": "5.2.0",
		"@react-native-firebase/app": "^26.4.0",
